# Número de WhatsApp de contacto, formato internacional sin "+" (ej. 51XXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=51900000000

# Dominio de producción (sin "/" final), usado para canonical, sitemap, OG y JSON-LD
NEXT_PUBLIC_SITE_URL=https://anvynt.com

# Opcional: ID de Google Analytics 4 (G-XXXXXXXXXX). Vacío = sin analítica.
NEXT_PUBLIC_GA_ID=

# Opcional: endpoint que recibe el correo del formulario de cotización (POST JSON {email, source}),
# p. ej. Formspree: https://formspree.io/f/XXXXXXXX. Vacío = usa FormSubmit hacia contacto@anvyt.com (src/lib/lead.js).
NEXT_PUBLIC_LEAD_ENDPOINT=

# Opcional: número de WhatsApp solo para el formulario "Cuéntanos tu caso" (datos e IA). Vacío = usa el general.
NEXT_PUBLIC_WHATSAPP_NUMBER_DATOS=
